        "measures": [
          {
            "name": "Orders",
            "expression": "COUNTROWS(Orders)",
            "lineageTag": "630b5326-18b6-4729-a66f-f49e38ea7d3f",
            "displayFolder": "Business KPIs",
            "formatString": "#,0"
          },
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE([Orders], Orders[Status] = \"delivered\")",
            "lineageTag": "5a73e373-47e2-4003-b14d-27ac6765febc",
            "displayFolder": "Business KPIs",
            "formatString": "#,0"
          },
          {
            "name": "Delivered GMV",
            "expression": "CALCULATE(SUM(Orders[GMV]), Orders[Status] = \"delivered\")",
            "lineageTag": "4a50f270-6860-4284-a9ae-51a514364a80",
            "displayFolder": "Business KPIs",
            "formatString": "\"R$ \"#,0.00"
          },
          {
            "name": "AOV",
            "expression": "DIVIDE([Delivered GMV], [Delivered Orders])",
            "lineageTag": "d59edbbf-6299-4a8d-a2db-f5b9f865c6af",
            "displayFolder": "Business KPIs",
            "formatString": "\"R$ \"#,0"
          },
          {
            "name": "Eligible Deliveries",
            "expression": "CALCULATE([Orders], Orders[Eligible] = 1)",
            "lineageTag": "a64419fa-6f6e-41b1-85ad-c1d1f4e0f69b",
            "displayFolder": "Business KPIs",
            "formatString": "#,0"
          },
          {
            "name": "Late Orders",
            "expression": "CALCULATE([Orders], Orders[Eligible] = 1, Orders[Late] = 1)",
            "lineageTag": "ec649b61-9f20-4fa4-aac9-7a8137221d2b",
            "displayFolder": "Business KPIs",
            "formatString": "#,0"
          },
          {
            "name": "Late Rate",
            "expression": "DIVIDE([Late Orders], [Eligible Deliveries])",
            "lineageTag": "a1cac284-4eb3-4817-8de4-a5dbe3664cef",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "On Time Rate",
            "expression": "IF([Eligible Deliveries]>0, 1-[Late Rate])",
            "lineageTag": "58d48a0b-2abc-4557-8a53-9db08c92d043",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "Reviewed Deliveries",
            "expression": "CALCULATE([Eligible Deliveries], KEEPFILTERS(NOT ISBLANK(Orders[ReviewScore])))",
            "lineageTag": "406611a8-8c92-468a-a4ce-d9e4e1f64878",
            "displayFolder": "Business KPIs",
            "formatString": "#,0"
          },
          {
            "name": "Average Review",
            "expression": "CALCULATE(AVERAGE(Orders[ReviewScore]), Orders[Eligible]=1)",
            "lineageTag": "265b2792-823e-484c-b118-98f2345af871",
            "displayFolder": "Business KPIs",
            "formatString": "0.00"
          },
          {
            "name": "Low Rating Rate",
            "expression": "DIVIDE(CALCULATE([Reviewed Deliveries], Orders[ReviewScore] IN {1,2}), [Reviewed Deliveries])",
            "lineageTag": "fb961301-0f60-41ae-9e50-3a7e93b981ed",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "Low Rating Late",
            "expression": "CALCULATE([Low Rating Rate], Orders[Late]=1)",
            "lineageTag": "8c8aab17-5568-4083-ab18-b828def95d53",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "Low Rating On Time",
            "expression": "CALCULATE([Low Rating Rate], Orders[Late]=0)",
            "lineageTag": "7c12dd9e-5d27-40dc-b8f4-e4104ad63761",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "Rating Risk Ratio",
            "expression": "DIVIDE([Low Rating Late],[Low Rating On Time])",
            "lineageTag": "0358fe74-1b4c-4e25-86cf-c8878ba7dbac",
            "displayFolder": "Business KPIs",
            "formatString": "0.0\"×\""
          },
          {
            "name": "Median Delivery Days",
            "expression": "CALCULATE(MEDIAN(Orders[DeliveryDays]), Orders[Eligible]=1)",
            "lineageTag": "b6b938f9-5297-4306-96e9-bc33b49eab70",
            "displayFolder": "Business KPIs",
            "formatString": "0.0\" days\""
          },
          {
            "name": "Freight Ratio",
            "expression": "DIVIDE(CALCULATE(SUM(Orders[Freight]),Orders[Status]=\"delivered\"),[Delivered GMV])",
            "lineageTag": "b5cc49a9-0dbf-42aa-9665-981c42a78b13",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "GMV Headline",
            "expression": "\"R$ \" & FORMAT(DIVIDE([Delivered GMV],1000000),\"0.00\") & \"M\"",
            "lineageTag": "025a0d73-cc79-44e4-a137-f57dd8a67e93",
            "displayFolder": "Display"
          },
          {
            "name": "Delivered Caption",
            "expression": "FORMAT([Delivered Orders],\"#,0\") & \" delivered orders · excludes freight\"",
            "lineageTag": "d223bb16-f963-4757-9257-dd1185c0bf4c",
            "displayFolder": "Display"
          },
          {
            "name": "Late Caption",
            "expression": "FORMAT([Late Orders],\"#,0\") & \" late / \" & FORMAT([Eligible Deliveries],\"#,0\") & \" eligible\"",
            "lineageTag": "4b55cbc6-4b2d-46a0-b853-c8d0fdc3e6f1",
            "displayFolder": "Display"
          },
          {
            "name": "Review Caption",
            "expression": "FORMAT([Reviewed Deliveries],\"#,0\") & \" reviewed eligible deliveries\"",
            "lineageTag": "d3979a4c-58cc-4fb6-9893-8da421b0226e",
            "displayFolder": "Display"
          },
          {
            "name": "Scope Caption",
            "expression": "FORMAT([Orders],\"#,0\") & \" orders in view\"",
            "lineageTag": "987d3b88-5b90-4422-a4a4-e0e8cf022bbe",
            "displayFolder": "Display"
          },
          {
            "name": "Growth Benchmark",
            "expression": "MAX(Benchmarks[YTDGrowth])",
            "lineageTag": "10f651c7-f367-4410-a831-036f1eb8f836",
            "displayFolder": "Fixed benchmarks",
            "formatString": "+0.0%;-0.0%"
          },
          {
            "name": "Repeat Benchmark",
            "expression": "MAX(Benchmarks[Repeat90])",
            "lineageTag": "52811224-e552-4303-9cf9-d7a3d3b6c962",
            "displayFolder": "Fixed benchmarks",
            "formatString": "0.0%"
          },
          {
            "name": "Risk Base Rate",
            "expression": "MAX(Benchmarks[RiskBaseRate])",
            "lineageTag": "51a026ba-24f1-40c7-908e-2cac09add167",
            "displayFolder": "Fixed benchmarks",
            "formatString": "0.0%"
          },
          {
            "name": "Risk Flagged Rate",
            "expression": "MAX(Benchmarks[RiskFlaggedRate])",
            "lineageTag": "dd4154db-c364-4e72-805f-5490bb95266a",
            "displayFolder": "Fixed benchmarks",
            "formatString": "0.0%"
          },
          {
            "name": "Risk Lift",
            "expression": "MAX(Benchmarks[RiskLift])",
            "lineageTag": "9f2624e4-8365-45e9-a17b-ed0a8a09efa3",
            "displayFolder": "Fixed benchmarks",
            "formatString": "0.00\"×\""
          },
          {
            "name": "Risk Capture",
            "expression": "MAX(Benchmarks[RiskCapture])",
            "lineageTag": "e549a103-5ef9-4870-9f92-d65376d880b2",
            "displayFolder": "Fixed benchmarks",
            "formatString": "0.0%"
          },
          {
            "name": "Cohort Repeat Rate",
            "expression": "MAX(Cohorts[Repeat90])",
            "lineageTag": "daf82df3-d05f-4c25-ae6a-191e103fd25b",
            "displayFolder": "Fixed benchmarks",
            "formatString": "0.0%"
          },
          {
            "name": "Cohort Buyers",
            "expression": "SUM(Cohorts[Customers])",
            "lineageTag": "4dc035c1-c474-4543-a938-028eef1e4cc9",
            "displayFolder": "Fixed benchmarks",
            "formatString": "#,0"
          },
          {
            "name": "Reduction Rate",
            "expression": "DIVIDE(SELECTEDVALUE(Reduction[Value],20),100)",
            "lineageTag": "a9393728-da4b-43a9-b0de-7a6bc4644c8a",
            "displayFolder": "Scenario",
            "formatString": "0%"
          },
          {
            "name": "Avoided Late Orders",
            "expression": "ROUND([Late Orders]*[Reduction Rate],0)",
            "lineageTag": "e694816f-adf3-4f76-9939-89317eb5a981",
            "displayFolder": "Scenario",
            "formatString": "#,0"
          },
          {
            "name": "Scenario Late Rate",
            "expression": "[Late Rate]*(1-[Reduction Rate])",
            "lineageTag": "6968ce45-4b79-4472-99a8-0b7006d315e7",
            "displayFolder": "Scenario",
            "formatString": "0.0%"
          },
          {
            "name": "Scenario Caption",
            "expression": "FORMAT([Late Rate],\"0.0%\") & \" → \" & FORMAT([Scenario Late Rate],\"0.0%\") & \" late rate\"",
            "lineageTag": "c1c584b8-a395-4a3d-97a8-bd2e5e9b65a6",
            "displayFolder": "Scenario"
          },
          {
            "name": "Top Category GMV",
            "expression": "IF(RANKX(ALLSELECTED(Categories[Category]),[Delivered GMV],,DESC,Dense)<=6,[Delivered GMV])",
            "lineageTag": "2b079b77-a986-4110-bdc1-940004aeb9ce",
            "displayFolder": "Ranking",
            "formatString": "\"R$ \"#,0"
          },
          {
            "name": "Top State Late Orders",
            "expression": "IF(RANKX(ALLSELECTED(States[State]),[Late Orders],,DESC,Dense)<=6,[Late Orders])",
            "lineageTag": "d42c38ea-1c1a-491a-b1df-0337ada1e7de",
            "displayFolder": "Ranking",
            "formatString": "#,0"
          },
          {
            "name": "Eligible Share",
            "expression": "DIVIDE([Eligible Deliveries],CALCULATE([Eligible Deliveries],REMOVEFILTERS(States)))",
            "lineageTag": "5b1be131-ab1e-4417-bd04-7f32cd179ee8",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "Delivery Band Share",
            "expression": "DIVIDE([Eligible Deliveries],CALCULATE([Eligible Deliveries],REMOVEFILTERS(Orders[DeliveryBand],Orders[DeliveryBandOrder])))",
            "lineageTag": "b956cb35-32bf-43d1-9871-8571ef508881",
            "displayFolder": "Business KPIs",
            "formatString": "0.0%"
          },
          {
            "name": "Seller Eligible",
            "expression": "CALCULATE([Eligible Deliveries],NOT ISBLANK(Orders[SingleSellerId]))",
            "lineageTag": "de23e4eb-878c-46dd-8315-fb54a098963c",
            "displayFolder": "Seller investigation",
            "formatString": "#,0"
          },
          {
            "name": "Seller Late",
            "expression": "CALCULATE([Late Orders],NOT ISBLANK(Orders[SingleSellerId]))",
            "lineageTag": "03084b9b-3ddf-4d0a-8072-0f36f6e95de0",
            "displayFolder": "Seller investigation",
            "formatString": "#,0"
          },
          {
            "name": "Seller Rate",
            "expression": "DIVIDE([Seller Late],[Seller Eligible])",
            "lineageTag": "26f61373-a205-4b23-88f0-2fddc21230cd",
            "displayFolder": "Seller investigation",
            "formatString": "0.0%"
          },
          {
            "name": "Queue Eligible",
            "expression": "IF([Seller Eligible]>=100 && NOT ISBLANK(SELECTEDVALUE(Sellers[SellerId])), [Seller Eligible])",
            "lineageTag": "63c22e44-5462-4ed5-9825-0564d3c6673e",
            "displayFolder": "Seller investigation",
            "formatString": "#,0"
          },
          {
            "name": "Queue Late",
            "expression": "IF([Seller Eligible]>=100 && NOT ISBLANK(SELECTEDVALUE(Sellers[SellerId])), [Seller Late])",
            "lineageTag": "1fd45940-a715-41fe-8b63-c5300db4fde1",
            "displayFolder": "Seller investigation",
            "formatString": "#,0"
          },
          {
            "name": "Queue Rate",
            "expression": "IF([Seller Eligible]>=100 && NOT ISBLANK(SELECTEDVALUE(Sellers[SellerId])), [Seller Rate])",
            "lineageTag": "4c991e1d-5bb1-4820-9daa-16eb12d1f9da",
            "displayFolder": "Seller investigation",
            "formatString": "0.0%"
          },
          {
            "name": "Queue GMV",
            "expression": "IF([Seller Eligible]>=100 && NOT ISBLANK(SELECTEDVALUE(Sellers[SellerId])), [Delivered GMV])",
            "lineageTag": "9363e4e6-a1cc-44d0-8b5b-226d480e20cf",
            "displayFolder": "Seller investigation",
            "formatString": "\"R$ \"#,0"
          }
        ]
      },
